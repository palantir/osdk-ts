    experimental_sendEvent(event: SendEventArguments, $options?: $AgentSendEventOptions): Promise<void>;
  }

  export interface SessionState extends $AgentSessionState {
    arguments: Record<string, never>;
    agentState: { data: Record<string, never> };
    contextItems: Record<string, ContextItem>;
  }

  export type ContextItem = never;

  export type ContextItems = Record<never, never>;

  export type SendEventArguments = never;

  export type Events = Record<never, never>;

  export type CreateSessionArguments = Record<string, never>;
}

/** @beta */
export interface noArgumentsAgent
  extends $AgentDefinition<noArgumentsAgent.Signatures>,
    $VersionBound<$ExpectedClientVersion> {
  __DefinitionMetadata?: {
    apiName: 'noArgumentsAgent';
    type: 'agent';
    version: '1.2.3';
    arguments: {};
    events: {};
    agentState: { nullable: false; struct: {}; type: 'struct' };
    contextItems: {};
    signatures: noArgumentsAgent.Signatures;
  };
  type: 'agent';
  apiName: 'noArgumentsAgent';
  version: '^1.0.0';
  osdkMetadata: typeof $osdkMetadata;
}

/** @beta */
export const noArgumentsAgent: noArgumentsAgent = {
  type: 'agent',
  apiName: 'noArgumentsAgent',
  version: '^1.0.0',
  osdkMetadata: $osdkMetadata,
};
",
