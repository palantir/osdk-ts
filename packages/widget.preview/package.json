{
  "name": "@osdk/widget.preview",
  "version": "0.0.0",
  "description": "Shared custom widget preview controls and state for local development and Foundry",
  "access": "public",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/palantir/osdk-ts.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "default": "./build/esm/index.js"
    },
    "./styles.css": "./build/esm/styles.css",
    "./*": {
      "import": {
        "types": "./build/types/public/*.d.ts",
        "default": "./build/esm/public/*.js"
      },
      "default": "./build/esm/public/*.js"
    }
  },
  "scripts": {
    "check-api": "api-extractor run --verbose --local",
    "check-attw": "attw --profile esm-only --pack . --exclude-entrypoints ./styles.css",
    "check-spelling": "cspell --quiet .",
    "clean": "rm -rf lib dist types build tsconfig.tsbuildinfo",
    "fix-lint": "oxlint -c ../../oxlint.config.ts --fix . && oxfmt -c ../../oxfmt.config.ts .",
    "lint": "oxlint -c ../../oxlint.config.ts . && oxfmt -c ../../oxfmt.config.ts --check .",
    "test": "vitest run",
    "transpileEsm": "monorepo.tool.transpile -f esm -m normal -t node && node scripts/build-css.mjs",
    "transpileTypes": "monorepo.tool.transpile -f esm -m types -t node",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "classnames": "2.3.2"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.10.0",
    "@blueprintjs/datetime": "^6.0.0",
    "@osdk/widget.api": "^3.23.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.10.0",
    "@blueprintjs/datetime": "^6.0.0",
    "@microsoft/api-documenter": "^7.26.32",
    "@microsoft/api-extractor": "^7.52.11",
    "@osdk/monorepo.api-extractor": "workspace:~",
    "@osdk/monorepo.tsconfig": "workspace:~",
    "@osdk/widget.api": "workspace:~",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^16.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-expect": "^1.3.0",
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "files": [
    "build/esm",
    "build/types",
    "CHANGELOG.md",
    "package.json",
    "templates",
    "*.d.ts"
  ],
  "module": "./build/esm/index.js",
  "types": "./build/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module"
}
