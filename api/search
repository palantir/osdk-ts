e-useObjectSet.tsx-UseObjectSetOptions"},"3968":{"id":"/reference/react/use-object-set-11","page_id":"/reference/react/use-object-set","tags":[],"type":"text","url":"/reference/react/use-object-set#type-table-useObjectSet.tsx-UseObjectSetOptions-pivotTo","content":"| `pivotTo?` | `LinkNames<Q>` | Link to pivot to (changes the type). Cannot be combined with `streamUpdates`. The server does not support websocket subscriptions for link-traversal queries. |\n| ---------- | -------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |","table":"type-table-useObjectSet.tsx-UseObjectSetOptions"},"3969":{"id":"/reference/react/use-object-set-12","page_id":"/reference/react/use-object-set","tags":[],"type":"text","url":"/reference/react/use-object-set#type-table-useObjectSet.tsx-UseObjectSetOptions-pageSize","content":"| `pageSize?` | `number` | The preferred page size for the list |\n| ----------- | -------- | ------------------------------------ |","table":"type-table-useObjectSet.tsx-UseObjectSetOptions"},"3970":{"id":"/reference/react/use-object-set-13","page_id":"/reference/react/use-object-set","tags":[],"type":"text","url":"/reference/react/use-object-set#type-table-useObjectSet.tsx-UseObjectSetOptions-orderBy","content":"| `orderBy?` | `{ [K in PropertyKeys<Q>]?: \"asc\" \\| \"desc\" \\| undefined; }` | Sort order for the results |\n| ---------- | ------------------------------------------------------------ | -------------------------- |","table":"type-table-useObjectSet.tsx-UseObjectSetOptions"},"3971":{"id":"/reference/react/use-object-set-14","page_id":"/reference/react/use-object-set","tags":[],"type":"text","url":"/reference/react/use-object-set#type-table-useObjectSet.tsx-UseObjectSetOptions-dedupeIntervalMs","content":"| `dedupeIntervalMs?` | `number` | Minimum time between fetch requests in milliseconds (defaults to 2000ms) |\n| -----------------