{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "app/**",
        "components/**",
        "content/**",
        "lib/**",
        "public/**",
        "scripts/**",
        "*.mjs",
        "*.json",
        "$TURBO_ROOT$/packages/react-components/docs/**",
        "$TURBO_ROOT$/packages/*/src/**"
      ],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
